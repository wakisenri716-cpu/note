{
  "name": "note-auto-poster",
  "version": "0.1.0",
  "private": true,
  "description": "RSSフィードの記事を要約し、note.comへ自動投稿(下書き作成)するバッチツール",
  "type": "module",
  "scripts": {
    "post": "tsx src/run.ts",
    "post:dry": "DRY_RUN=true tsx src/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
