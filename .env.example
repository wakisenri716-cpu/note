# 要約元にするRSS/AtomフィードのURL(カンマ区切り、複数可)
# 例: FEED_URLS=https://example.com/feed,https://blog.example.jp/rss
FEED_URLS=

# --- 要約 (Claude) ---
# 未設定の場合はMockSummarizer(見出し+リード文を機械的に整形するだけ)で動作します
ANTHROPIC_API_KEY=

# --- note.com (非公式API) ---
# 両方未設定の場合はMockNoteClient(実際には投稿せず、内容をログ出力するだけ)で動作します
# note.comのログインID(メールアドレス)とパスワード
NOTE_EMAIL=
NOTE_PASSWORD=

# true にすると下書きではなく実際に公開まで行う(既定は下書き保存のみ)
NOTE_AUTO_PUBLISH=false

# 1回の実行で処理する新着記事の最大件数
MAX_ARTICLES_PER_RUN=3
