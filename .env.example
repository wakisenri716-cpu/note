# 要約元にする国際ニュースRSS/AtomフィードのURL(カンマ区切り、複数可)
# 下記は代表的な国際ニュースメディアの例。URLはメディア側の都合で変わることがあるので、
# 一度 npm run post:dry で実際に記事が取れるか確認してから使ってください。
# 例:
# FEED_URLS=http://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www3.nhk.or.jp/rss/news/cat6.xml
FEED_URLS=

# --- 要約 (Claude) ---
# 未設定の場合はMockSummarizer(見出し+リード文を機械的に整形するだけ)で動作します
ANTHROPIC_API_KEY=

# --- note.com (非公式API) ---
# 両方未設定の場合はMockNoteClient(実際には投稿せず、内容をログ出力するだけ)で動作します
# note.comのログインID(メールアドレス)とパスワード
NOTE_EMAIL=
NOTE_PASSWORD=

# true にすると下書きではなく実際に公開まで行う(既定は下書き保存のみ)
NOTE_AUTO_PUBLISH=false

# 1回の実行で処理する新着記事(トピック)の最大件数。1日の投稿本数になります
MAX_ARTICLES_PER_RUN=5
